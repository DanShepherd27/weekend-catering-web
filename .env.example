# SMTP Configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password

# Email addresses
# IMPORTANT: EMAIL_FROM must be a valid email that can SEND mail
# Use the same email as SMTP_USER to avoid delivery issues
# Do NOT use domains with null MX records (domains that don't accept mail)
EMAIL_FROM=your-email@example.com
EMAIL_TO=owner-email@example.com

# Altcha HMAC Key for CAPTCHA verification
ALTCHA_HMAC_KEY=your-secret-hmac-key-change-this-in-production
